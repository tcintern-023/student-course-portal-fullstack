# Port the Express server listens on
PORT=4000

# URL of the Next.js frontend, used to configure CORS
CLIENT_URL=http://localhost:3000

# PostgreSQL connection string.
# For local testing:   postgresql://postgres:postgres@localhost:5432/course_portal
# For Neon (copy from your Neon project's "Connection string" panel):
#   postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/course_portal

# Secret used to sign/verify JWTs. Use a long random string in production
# (e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-this-with-a-long-random-string
